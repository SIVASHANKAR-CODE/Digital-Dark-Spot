{
  "name": "digital-dark-spot",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Assisted Information Gap Detection Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan.bold,green.bold\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "build:shared": "npm --prefix packages/shared run build",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/api start",
    "test": "cd apps/api && npx tsx ../../tests/runTests.ts && npx tsx ../../tests/integrationTest.ts",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "cd apps/web && npx tsc --noEmit && cd ../api && npx tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^11.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "sanitize-html": "^2.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "@types/sanitize-html": "^2.11.0",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^3.2.29",
    "concurrently": "^8.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
