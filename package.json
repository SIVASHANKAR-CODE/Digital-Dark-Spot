{
  "name": "digital-dark-spot",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Assisted Information Gap Detection Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "build:shared": "cd packages/shared && npm run build",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "start": "cd apps/api && npm start",
    "test": "cd apps/api && npx tsx ../../tests/runTests.ts && npx tsx ../../tests/integrationTest.ts",
    "lint": "cd apps/web && npm run lint",
    "typecheck": "cd apps/web && npx tsc --noEmit && cd ../api && npx tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

