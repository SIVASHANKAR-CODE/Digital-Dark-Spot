# Environment Variables for Digital Dark Spot
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB (optional - uses in-memory store if not provided)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/digital-dark-spot

# AI Provider - Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# AI Provider Selection (gemini | openai)
AI_PROVIDER=gemini

# Web Search API (optional)
SEARCH_API_KEY=your_search_api_key_here
SEARCH_PROVIDER=google

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Analysis
MAX_SOURCES_PER_RESEARCH=10
MAX_CONTENT_LENGTH_BYTES=5242880
REQUEST_TIMEOUT_MS=30000

